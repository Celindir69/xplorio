/* Own additions for the Xplorio plugin: save a copy on the player as /data/xplorio/config.local.js, adjust it, then
   switch the plugin off and on once. The values of the plugin's settings page (language, theme, Rotel address, streaming
   services, …) come after this file and win, so set those on the settings page.
   The Last.fm key and secret do not belong here (any browser can load this file); enter them on the settings page. */
/* Remote control for another model or custom input names (default: RA-1572 / RA-1572MKII):
window.APP_CONFIG.ROTEL_PROFILE = {
  sources: [{cmd: 'pcusb', name: 'Player'}, {cmd: 'opt1', name: 'TV'}],
  speakerB: false
};
*/
/* Amplifier port, if it is not 9590 (e.g. Rotel Michi P5: 9596):
window.APP_CONFIG.ROTEL_AMP_PORT = 9596;
*/
